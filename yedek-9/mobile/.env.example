# API - For simulators use defaults (no need to set).
# For physical devices, use your Mac's IP: EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000/api
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api
EXPO_PUBLIC_WS_URL=http://127.0.0.1:3000

# Environment
ENV=development
EXPO_PUBLIC_APP_ENV=development

# Sentry (optional) - Leave empty to disable error tracking
# Get DSN from https://sentry.io → Project → Client Keys
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# EXPO_PUBLIC_SENTRY_DEV_ENABLED=false  # Set true to test Sentry in dev

# Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_USE_MAPBOX_LOCAL=false
# EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=pk.your_public_token
# EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-user/your-style-id
