# Server
PORT=3000
# IMPORTANT: Set NODE_ENV=production and use HTTPS in real deployments
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/local_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=local_db
DB_USER=your_user
DB_PASSWORD=your_password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# PRODUCTION: 64+ chars. Example: openssl rand -base64 64
JWT_SECRET=your_min_64_char_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# CORS
# PRODUCTION: Set to your app origins only, e.g. https://app.local.com — never use * in production
CORS_ORIGIN=http://localhost:19006

# Admin (optional): comma-separated emails and/or user UUIDs for admin panel & moderation
# ADMIN_EMAILS=admin@example.com,200541032@firat.edu.tr
# ADMIN_USER_IDS=uuid1,uuid2

# Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications
FCM_SERVER_KEY=your_fcm_server_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sentry (optional) - Leave empty to disable error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# AWS S3 Media
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_bucket_name
AWS_S3_REGION=eu-west-1
# Backward-compatible alias (optional)
# AWS_REGION=eu-west-1

# Media storage: auto | s3 | local
# auto = S3 when AWS creds+bucket set, otherwise local disk (backend/uploads)
MEDIA_STORAGE=auto
# Public base URL used in signed media links (phone needs LAN IP, not localhost)
API_PUBLIC_URL=http://127.0.0.1:3000
# MEDIA_SIGNING_SECRET=change-me

# Email provider (optional; required if EMAIL_SERVICE_ENABLED=true in non-dev)
SENDGRID_API_KEY=your_sendgrid_api_key

# Check-in GPS threshold (meters)
CHECKIN_GPS_MAX_METERS=200

# Venue package payments. Without STRIPE_SECRET_KEY upgrades queue as requests.
# Live checklist:
#   1) STRIPE_SECRET_KEY=sk_test_...
#   2) STRIPE_WEBHOOK_SECRET=whsec_... → POST /api/venues/stripe-webhook
#   3) Optional STRIPE_PRICE_OPERATOR / STRIPE_PRICE_HAKIM
#   4) Smoke: GET /api/venues/payment-readiness
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_CURRENCY=try
# STRIPE_PRICE_OPERATOR=price_xxx
# STRIPE_PRICE_HAKIM=price_xxx
# STRIPE_SUCCESS_URL=https://app.local.com/venue-package/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://app.local.com/venue-package/cancel
# Smoke: GET /api/venues/payment-readiness → stripe_enabled true

# KYC provider: stub | techsign | ihs (falls back to identity.ACTIVE_PROVIDER)
# Absolute-100 B: set live provider + keys for live_mode; mobile bootstraps client_token.
# KYC_PROVIDER=stub
# Live HTTP (Phase 2) — only activates when BASE_URL + API_KEY are set
# KYC_TECHSIGN_BASE_URL=https://sandbox.techsign.example
# KYC_TECHSIGN_API_KEY=
# KYC_TECHSIGN_WEBHOOK_SECRET=
# KYC_TECHSIGN_START_PATH=/v1/kyc/sessions
# KYC_TECHSIGN_COMPLETE_PATH=/v1/kyc/sessions/{session_id}/complete
# KYC_IHS_BASE_URL=
# KYC_IHS_API_KEY=
# KYC_IHS_WEBHOOK_SECRET=
# Public URL vendor will POST to (HMAC with WEBHOOK_SECRET)
# KYC_WEBHOOK_PUBLIC_URL=https://api.example.com/api/identity/kyc-webhook?provider=techsign
# Smoke: GET /api/identity/live-readiness → live_mode true

# Public media CSAM/nudity scan. Unset => public held + ops queue (product-complete fail-closed).
# Option A — generic webhook:
# CSAM_SCAN_WEBHOOK_URL=https://scanner.example.com/scan
# CSAM_SCAN_API_KEY=
# CSAM_SCAN_TIMEOUT_MS=8000
# Option B — Sightengine:
# CSAM_PROVIDER=sightengine
# SIGHTENGINE_API_USER=
# SIGHTENGINE_API_SECRET=
# CSAM_FLAG_THRESHOLD=0.5
# Smoke: GET /api/mod/csam-readiness
