{
  "name": "local-backend",
  "version": "1.0.0",
  "description": "LOCAL backend API and services",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch=false --watchman=false --forceExit",
    "migrate": "node scripts/run-migrations.js",
    "simulate:rs": "node src/scripts/runRsSanitySimulation.js",
    "migrate:dev": "NODE_ENV=development node scripts/run-migrations.js",
    "seed:pulse": "node src/scripts/create_pulse_sample_data_milano.js",
    "seed:pulse:istanbul": "node src/scripts/create_pulse_sample_data_istanbul.js",
    "seed:pulse:all": "node src/scripts/create_pulse_sample_data_milano.js && node src/scripts/create_pulse_sample_data_istanbul.js",
    "seed:host-memory": "node src/scripts/add_host_memory_example.js",
    "seed:social-passport": "node src/scripts/seed_social_passport_arda.js",
    "seed:pulse:arda": "node src/scripts/seed_pulse_arda.js",
    "seed:friends-tab": "node src/scripts/seed_friends_tab_data.js",
    "seed:pulse:showcase": "node src/scripts/seed_pulse_showcase.js",
    "seed:viewer-demo": "node src/scripts/seed_viewer_full_demo.js",
    "smoke:viewer": "node src/scripts/smoke_test_viewer.js",
    "seed:pulse:test-attendee2": "node src/scripts/seed_pulse_test_attendee2.js",
    "seed:pulse:social-viewer": "node src/scripts/seed_pulse_social_for_viewer.js",
    "clear:rituals": "node src/scripts/clear_all_rituals.js",
    "clear:seed": "node src/scripts/clear_seed_data.js",
    "seed:live-more": "node src/scripts/add_more_live_rituals.js",
    "load-test:basic": "k6 run load-tests/k6-basic.js",
    "load-test:stress": "k6 run load-tests/k6-stress.js",
    "load-test:artillery": "artillery run load-tests/artillery-config.yml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1028.0",
    "@aws-sdk/s3-request-presigner": "^3.1028.0",
    "@countrystatecity/countries": "^1.0.9",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "music-metadata": "^11.12.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "sharp": "^0.34.5",
    "socket.io": "^4.6.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@jest/test-sequencer": "^30.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "local",
    "social",
    "presence",
    "rituals"
  ],
  "author": "",
  "license": "ISC"
}
