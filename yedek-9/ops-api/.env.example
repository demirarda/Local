PORT=3001
NODE_ENV=development

# Same Postgres as production backend (ops schema)
DATABASE_URL=postgresql://user:password@localhost:5432/local_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=local_db
DB_USER=your_user
DB_PASSWORD=your_password

# Separate secret from production JWT
OPS_JWT_SECRET=change-me-ops-portal-min-32-chars
OPS_JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Optional: read-only bridge to production tables (public schema)
# PRODUCTION_DATABASE_URL=postgresql://...
